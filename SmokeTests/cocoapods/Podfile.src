abstract_target 'Common' do
  pod 'OpenTelemetry-Swift-Api', '2.5.0'
  pod 'TowerSignalInternal', :git => 'https://github.com/TowerSignal/towersignal-sdk-ios.git', :GIT_REFERENCE
  pod 'TowerSignalCore', :git => 'https://github.com/TowerSignal/towersignal-sdk-ios.git', :GIT_REFERENCE
  pod 'TowerSignalLogs', :git => 'https://github.com/TowerSignal/towersignal-sdk-ios.git', :GIT_REFERENCE
  pod 'TowerSignalTrace', :git => 'https://github.com/TowerSignal/towersignal-sdk-ios.git', :GIT_REFERENCE
  pod 'TowerSignalRUM', :git => 'https://github.com/TowerSignal/towersignal-sdk-ios.git', :GIT_REFERENCE
  pod 'TowerSignalCore', :git => 'https://github.com/TowerSignal/towersignal-sdk-ios.git', :GIT_REFERENCE
  pod 'TowerSignalSessionReplay', :git => 'https://github.com/TowerSignal/towersignal-sdk-ios.git', :GIT_REFERENCE
  pod 'TowerSignalCrashReporting', :git => 'https://github.com/TowerSignal/towersignal-sdk-ios.git', :GIT_REFERENCE
  pod 'TowerSignalFlags', :git => 'https://github.com/TowerSignal/towersignal-sdk-ios.git', :GIT_REFERENCE
  pod 'TowerSignalProfiling', :git => 'https://github.com/TowerSignal/towersignal-sdk-ios.git', :GIT_REFERENCE

  target 'App Dynamic iOS' do
    platform :ios, '13.0'
    use_frameworks!
    pod 'TowerSignalWebViewTracking', :git => 'https://github.com/TowerSignal/towersignal-sdk-ios.git', :GIT_REFERENCE

    target 'App Dynamic iOS Tests' do
      inherit! :search_paths
    end
  end

  target 'App Static iOS' do
    platform :ios, '13.0'
    pod 'TowerSignalWebViewTracking', :git => 'https://github.com/TowerSignal/towersignal-sdk-ios.git', :GIT_REFERENCE

    target 'App Static iOS Tests' do
      inherit! :search_paths
    end
  end

  target 'App Dynamic tvOS' do
    platform :tvos, '13.0'
    use_frameworks!

    target 'App Dynamic tvOS Tests' do
      inherit! :search_paths
    end
  end

  target 'App Static tvOS' do
    platform :tvos, '13.0'

    target 'App Static tvOS Tests' do
      inherit! :search_paths
    end
  end

end
